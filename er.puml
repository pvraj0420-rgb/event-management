@startuml

entity users {
  +id : bigint <<PK>>
  name : varchar
  email : varchar
  password : varchar
  phone : varchar
  created_at : timestamp
  updated_at : timestamp
}

entity admins {
  +id : bigint <<PK>>
  name : varchar
  email : varchar
  password : varchar
  created_at : timestamp
  updated_at : timestamp
}

entity categories {
  +id : bigint <<PK>>
  name : varchar
  description : text
  created_at : timestamp
  updated_at : timestamp
}

entity speakers {
  +id : bigint <<PK>>
  name : varchar
  bio : text
  contact : varchar
  created_at : timestamp
  updated_at : timestamp
}

entity events {
  +id : bigint <<PK>>
  title : varchar
  description : text
  date : date
  time : time
  location : varchar
  category_id : bigint <<FK>>
  speaker_id : bigint <<FK>>
  created_at : timestamp
  updated_at : timestamp
}

entity bookings {
  +id : bigint <<PK>>
  user_id : bigint <<FK>>
  event_id : bigint <<FK>>
  tickets : int
  total_amount : decimal
  payment_status : varchar
  payment_method : varchar
  booking_date : date
  created_at : timestamp
  updated_at : timestamp
}

' Relationships
users ||--o{ bookings : "makes"
events ||--o{ bookings : "has"
categories ||--o{ events : "contains"
speakers ||--o{ events : "assigned to"
admins ||--o{ events : "manages"

@enduml